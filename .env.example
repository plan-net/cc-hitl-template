# Claude Agent SDK Authentication
# Supports both Public Anthropic API and Azure Foundry (Microsoft)
#
# Copy this file to .env and configure for your API provider.
# These values must also be set in Ray Serve config (runtime_env.env_vars).

# =============================================================================
# API Provider Selection
# =============================================================================
# Set to "1" to use Azure Foundry, leave unset for Public Anthropic API
# CLAUDE_CODE_USE_FOUNDRY=1

# =============================================================================
# Public Anthropic API (default)
# =============================================================================
# Get your API key from: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...your-key-here...

# =============================================================================
# Azure Foundry (Microsoft) - when CLAUDE_CODE_USE_FOUNDRY=1
# =============================================================================
# ANTHROPIC_FOUNDRY_BASE_URL=https://your-resource.services.ai.azure.com
# ANTHROPIC_FOUNDRY_API_KEY=your-azure-api-key

# =============================================================================
# Actor Resource Configuration
# =============================================================================
# CLAUDE_ACTOR_CPUS=1
# CLAUDE_ACTOR_MEMORY_GB=2

# GitHub Container Registry Authentication (for build-and-push.sh)
# Create a Personal Access Token at: https://github.com/settings/tokens
# Token needs 'packages:write' scope to push images to ghcr.io
# Also needs 'read:packages' scope to pull private images
GITHUB_TOKEN=ghp_...your-token-here...

# GitHub Username (for image registry path)
# Used by build-and-push.sh to construct ghcr.io/<username>/claude-hitl-worker:latest
GITHUB_USERNAME=your-github-username

# Configuration Repository URLs
# These repos contain .claude/ folders that are baked into the container image
# Master config: Template/user-level Claude Code settings (commands, skills, etc.)
# Project config: Project-specific Claude Code configuration
MASTER_CONFIG_REPO=git@github.com:your-org/cc-master-agent-config.git
PROJECT_CONFIG_REPO=git@github.com:your-org/cc-example-agent-config.git

# Container Image Configuration
# Full URI with immutable digest (SHA256) for Ray actors
# Format: ghcr.io/<username>/claude-hitl-worker@sha256:<full-digest>
# This ensures Ray actors use the exact container image version you built
# Get this value from the docker-build skill output after building
# IMPORTANT: Must also be set in data/config/claude_hitl_template.yaml
CONTAINER_IMAGE_URI=ghcr.io/your-github-username/claude-hitl-worker@sha256:...your-digest-here...

# Plugin Marketplaces (Documentation Only)
# These URLs are configured in config repo settings.json files
# The build process reads marketplace URLs from settings.json, NOT from .env
# Listed here for reference only

# Developer marketplace - tools for setup, deployment, testing
# Contains: general, claude-agent-sdk plugins
MARKETPLACE_DEVELOPERS_URL=https://github.com/plan-net/cc-marketplace-developers.git

# Agent marketplace - runtime capabilities for deployed HITL agents
# Contains: master-core, hitl-example plugins
MARKETPLACE_AGENTS_URL=https://github.com/plan-net/cc-marketplace-agents.git

# To enable plugins, add them to your config repo's .claude/settings.json:
# {
#   "extraKnownMarketplaces": {
#     "cc-marketplace-developers": {
#       "source": {"source": "github", "repo": "plan-net/cc-marketplace-developers"}
#     }
#   },
#   "enabledPlugins": {
#     "general@cc-marketplace-developers": true
#   }
# }
